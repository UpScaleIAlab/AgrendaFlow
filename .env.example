NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only secrets; never expose with NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
MERCADOPAGO_ACCESS_TOKEN=YOUR_MERCADOPAGO_ACCESS_TOKEN
# Share URL copied from your Mercado Pago subscription plan (no API checkout creation).
MERCADOPAGO_SUBSCRIPTION_URL=https://www.mercadopago.cl/subscriptions/checkout?preapproval_plan_id=YOUR_PLAN_ID
MERCADOPAGO_WEBHOOK_SECRET=YOUR_MERCADOPAGO_WEBHOOK_SECRET
NEXT_PUBLIC_SITE_URL=https://your-agendaflow-domain.com
